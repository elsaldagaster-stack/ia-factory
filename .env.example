# IA Factory — Variables de Entorno
# Copiar a .env y completar con valores reales
# NUNCA commitear .env con valores reales

# === PARÁMETROS DE MODELO ===
# Completar con el modelo elegido para cada rol
# Formato Anthropic: claude-opus-4-7 / claude-sonnet-4-6 / claude-haiku-4-5-20251001
# Formato OpenAI:    gpt-4o / gpt-4o-mini / o3 / o3-mini
# Formato Google:    gemini-2.0-flash / gemini-2.5-pro

PARAM_MODEL_STRATEGIC=          # Alto razonamiento, contexto largo — specs y decisiones arquitectónicas
PARAM_MODEL_CODER=              # Especializado en código — implementación
PARAM_MODEL_REVIEWER_SECURITY=  # FAMILIA DIFERENTE a CODER (obligatorio) — revisión de seguridad
PARAM_MODEL_REVIEWER_CODE=      # Revisión de código y consistencia con BRAIN.md
PARAM_MODEL_VISUAL=             # Tareas con imágenes/diagramas (opcional en fase inicial)
PARAM_MODEL_FAST=               # Modelo rápido/barato — clasificación, tareas simples

# === BASE DE DATOS ===
DATABASE_URL=                   # Neon pooled URL — formato: postgresql://user:pass@ep-xxx.pooler.neon.tech/db?sslmode=require
DIRECT_URL=                     # Neon unpooled URL — requerido para prisma migrate (sin pgBouncer)

# === AUTENTICACIÓN (Clerk) ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/projects

# === EMAIL (Resend) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=                 # Sender address — format: "IA Factory <noreply@yourdomain.com>"

# === API KEYS (modelos IA) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
